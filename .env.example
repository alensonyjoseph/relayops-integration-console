# Local Docker Compose does not require this file.
# Vercel API service: configure these in the project environment settings.
# Use a separate dedicated managed PostgreSQL database for this public portfolio demo.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DEMO_MODE=true

# Explicit opt-in: only for a brand-new dedicated public demo database.
AUTO_MIGRATE_DEMO=false
